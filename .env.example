# ---- GM service (server-side; set as Vercel env vars, never in the client) ----
# Model calls go through Vercel AI Gateway, which implements the Anthropic
# Messages API spec — so api/_lib/anthropic.ts is the official @anthropic-ai/sdk
# with a different baseURL, and structured outputs work unchanged.
#
# Auth, in precedence order (first one set wins):
#   AI_GATEWAY_API_KEY  — an AI Gateway key; needed for local dev / non-Vercel hosts.
#   VERCEL_OIDC_TOKEN   — injected automatically into every Vercel deployment,
#                         so a deployed GM needs NO secret configured at all.
#   ANTHROPIC_API_KEY   — last resort; pair with GM_BASE_URL to bypass the gateway.
AI_GATEWAY_API_KEY=

# Optional: point the SDK somewhere other than the gateway, e.g.
# https://api.anthropic.com for local debugging against a direct Anthropic key.
GM_BASE_URL=

# Model ids are config, not code (docs/design/gm-system.md). These are GATEWAY
# slugs: "provider/model" with DOTTED minor versions. The direct-API spelling
# (claude-haiku-4-5) is NOT valid here.
GM_MODEL=anthropic/claude-haiku-4.5
GM_PARTY_MODEL=anthropic/claude-sonnet-5

# Optional shared content pool: Upstash Redis over REST. When unset the pool
# falls back to a per-instance in-memory store (fine for local dev).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---- Game client (Vite; optional) ----
# Base URL of the GM api. Defaults to same-origin "/api" (the Vercel deploy).
# Point at another deployment for local dev against a preview, e.g.
# VITE_GM_URL=https://c-at-rpg-preview.vercel.app/api
VITE_GM_URL=
