{
  "name": "c-at-rpg",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "npm run dev",
    "build": "npm run lint && tsc && vite build",
    "lint": "eslint .",
    "dev": "vite",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "typecheck:api": "tsc -p api/tsconfig.json",
    "typecheck:agent": "tsc -p agent/tsconfig.json",
    "dm:dev": "eve dev",
    "dm:build": "eve build",
    "dm:deploy": "eve deploy",
    "sim": "tsx scripts/sim.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "ai": "^7.0.44",
    "eve": "^0.29.2",
    "pixi.js": "^8.8.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@types/node": "^24.13.3",
    "eslint": "^9.21.0",
    "eslint-config-prettier": "^10.1.2",
    "eslint-plugin-prettier": "^5.2.6",
    "playwright": "^1.62.0",
    "prettier": "^3.5.3",
    "typescript": "~5.7.3",
    "typescript-eslint": "^8.25.0",
    "vite": "^6.2.0",
    "vitest": "^4.1.10"
  }
}
