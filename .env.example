# ---- The DM (the eve agent in agent/) ----
# The DM is its OWN Vercel project (docs/DM-DEPLOY.md). Model calls go through
# Vercel AI Gateway with the deployment's own OIDC token, so a deployed DM
# needs NO provider API key configured at all.
#
# Local development against the gateway, first one set wins:
#   VERCEL_OIDC_TOKEN   — written by `vercel env pull` when the project is linked
#   AI_GATEWAY_API_KEY  — an AI Gateway key, for unlinked checkouts
AI_GATEWAY_API_KEY=

# CORS origins the DM answers (comma-separated). Unset = the defaults in
# agent/channels/eve.ts. Set this on the DM deployment, not locally.
DM_ALLOWED_ORIGINS=

# Set before `npm run dm:dev <url>` if the deployment has Deployment Protection on.
VERCEL_AUTOMATION_BYPASS_SECRET=

# ---- The shared content pool (server-side; agent/lib/pool.ts) ----
# Optional: Upstash Redis over REST. When unset the pool falls back to a
# per-instance in-memory store (fine for local dev; nothing is actually shared).
# The DM's contribute_content tool and scripts/seed-pool.ts are its only users.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---- Game client (Vite) ----
# Absolute origin of the DM deployment. UNSET IS SUPPORTED: the reachability
# probe short-circuits without a request and the game plays offline on authored
# content — no typed actions, no party generation, no resonance, no errors.
# There is no /api fallback any more; the api/gm/* functions are deleted.
# VITE_DM_URL=https://c-at-rpg-dm.vercel.app
VITE_DM_URL=
