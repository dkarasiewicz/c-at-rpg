{
  // Standalone tsconfig for the Vercel serverless functions. The app's root
  // tsconfig includes only src/ (so `npm run typecheck` and `vite build`
  // never touch api/); check this package with: npx tsc -p api/tsconfig.json
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["**/*.ts"]
}
